#!/bin/bash
#$ -N jgrid_00000
#$ -pe smp 60
#$ -l h_vmem=  256G
#$ -o /ddn/niknovikov19/repo/A1_model_old/grid_batch_v34_batch56/grid_00000.run
cd /ddn/niknovikov19/repo/A1_model_old/model
source ~/.bashrc
export SOCNAME="('10.0.0.101', 48987)"
export JOBID=$JOB_ID

export INTRUNTK0="EbkgThalamicGain=2"
export STRRUNTK1="saveFolder=../grid_batch_v34_batch56"
export STRRUNTK2="simLabel=grid_00000"
conda activate netpyne_batch 
export LD_LIBRARY_PATH=$CONDA_PREFIX/lib:$LD_LIBRARY_PATH 
mpiexec -n $NSLOTS -hosts $(hostname) nrniv -python -mpi init_v34_batch56.py


